{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/enquiries/validate", "destination": "/api/enquiries" },
    { "source": "/api/newsletter/validate", "destination": "/api/subscribe" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/work", "destination": "/work/index.html" },
    { "source": "/speaking", "destination": "/speaking/index.html" },
    { "source": "/impact", "destination": "/impact/index.html" },
    { "source": "/story", "destination": "/story/index.html" },
    { "source": "/cv", "destination": "/cv/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog-admin", "destination": "/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/enquiries", "destination": "/enquiries/index.html" },
    { "source": "/((?!api/|assets/|favicon\\.svg|og_social_preview\\.jpg|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ]
}
